# Server
PORT=4000
CLIENT_URL=http://localhost:8080

# Supabase (find these in Project Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service role key — server-side ONLY. Never send this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Anon/public key — safe for the frontend, kept here too for reference.
SUPABASE_ANON_KEY=your-anon-key

# Stripe — requires Connect enabled on your Stripe account
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx
# Price ID for the "large merchant" subscription plan — create this
# product/price in the Stripe Dashboard first, there is no default.
STRIPE_PREMIUM_PRICE_ID=price_xxxxxxxxxxxxx

# Platform commission, as a percentage of each sale's subtotal.
# These are placeholders — set real values before launch.
PLATFORM_COMMISSION_PERCENT=12
PLATFORM_COMMISSION_PERCENT_PREMIUM=6

# Shared secret required in the `x-admin-api-key` header to call admin-only
# routes (currently just POST /api/orders/:id/refund). Generate a long
# random value, e.g. `openssl rand -hex 32` — never reuse a guessable value.
ADMIN_API_KEY=

# Twilio — OPTIONAL. Sends a buyer an order-confirmation SMS/WhatsApp
# message once Stripe confirms payment (see server/lib/notify.js).
# Leave these blank and nothing breaks — checkout/webhooks work exactly
# the same without them, just silently skipping the notification.
# Find ACCOUNT_SID / AUTH_TOKEN in the Twilio Console; SMS_FROM is a
# Twilio phone number you bought; WHATSAPP_FROM is a WhatsApp-enabled
# sender (Twilio's sandbox number while testing, your own number once
# approved) — WhatsApp also needs an approved message template before
# it can message a buyer first (see README).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
