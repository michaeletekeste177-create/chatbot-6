# Server
PORT=4000
CLIENT_URL=http://localhost:8080

# Supabase (find these in Project Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service role key — server-side ONLY. Never send this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Anon/public key — safe for the frontend, kept here too for reference.
SUPABASE_ANON_KEY=your-anon-key

# Stripe — requires Connect enabled on your Stripe account
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx
# Price ID for the "large merchant" subscription plan — create this
# product/price in the Stripe Dashboard first, there is no default.
STRIPE_PREMIUM_PRICE_ID=price_xxxxxxxxxxxxx

# Platform commission, as a percentage of each sale's subtotal.
# These are placeholders — set real values before launch.
PLATFORM_COMMISSION_PERCENT=12
PLATFORM_COMMISSION_PERCENT_PREMIUM=6
