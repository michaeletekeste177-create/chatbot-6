{
  "name": "Hibretfamily (Node.js)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bullseye",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "public/index.html"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  },
  "updateContentCommand": "cd server && [ -f package.json ] && npm install; echo '✅ Backend dependencies installed'",
  "postAttachCommand": {
    "frontend": "npx --yes http-server public -p 8080 -c-1",
    "backend": "cd server && [ -f .env ] || cp .env.example .env; npm run dev"
  },
  "portsAttributes": {
    "8080": { "label": "Frontend (static site)", "onAutoForward": "openPreview" },
    "4000": { "label": "Backend API", "onAutoForward": "notify" }
  },
  "forwardPorts": [8080, 4000]
}
